<odoo>
    <record id="l10n_br_account_payment_itau_api_payment_line_tree" model="ir.ui.view">
        <field name="name">account.payment.line.tree.itau.api</field>
        <field name="model">account.payment.line</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_line_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='move_line_id']" position="after">
                <field name="cnab_state" optional="show" />
                <field name="payment_situation" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="l10n_br_account_payment_itau_api_payment_line_form" model="ir.ui.view">
        <field name="name">account.payment.line.form.itau.api</field>
        <field name="model">account.payment.line</field>
        <field
            name="inherit_id"
            ref="account_payment_order.account_payment_line_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='right']" position="after">
                <group string="Boleto API Events">
                    <field
                        name="boleto_api_event_ids"
                        nolabel="1"
                        context="{'default_payment_line_id': id}"
                    >
                        <tree editable="false">
                            <field name="create_date" />
                            <field name="event_type" />
                            <field name="file_request_id" />
                            <field name="file_response_id" />
                            <field name="response_message" />
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
