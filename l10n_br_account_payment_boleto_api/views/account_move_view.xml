<odoo>
    <record id="l10n_br_account_payment_itau_api_move_cnab_form" model="ir.ui.view">
        <field name="name">account.move.cnab.view.itau.api</field>
        <field name="model">account.move</field>
        <field
            name="inherit_id"
            ref="l10n_br_account_payment_order.view_move_cnab_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='view_boleto_pdf']" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', ('state', '!=', 'posted'), ('payment_method_code', 'not in', ('240', '400', '500', 'itau_api'))]}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
