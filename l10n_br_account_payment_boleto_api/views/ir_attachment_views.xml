<odoo>
    <record id="l10n_br_account_payment_itau_api_ir_attachment_form" model="ir.ui.view">
        <field name="name">ir.attachment.form.itau.api.json</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='datas']" position="after">
                <field name="json_content" widget="text" />
            </xpath>
        </field>
    </record>
</odoo>
