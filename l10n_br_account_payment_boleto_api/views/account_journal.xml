<odoo>
    <record
        id="l10n_br_account_payment_boleto_api_account_journal_form"
        model="ir.ui.view"
    >
        <field name="name">account.journal.form.boleto.api.inbound</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@id='inbound_payment_settings']//field[@name='inbound_payment_method_line_ids']//field[@name='payment_method_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('payment_type', '=?', payment_type)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
