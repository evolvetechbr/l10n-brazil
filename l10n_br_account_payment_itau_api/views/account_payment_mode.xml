<odoo>
    <record id="l10n_br_account_payment_itau_api_payment_mode_form" model="ir.ui.view">
        <field name="name">account.payment.mode.form.itau.api</field>
        <field name="model">account.payment.mode</field>
        <field
            name="inherit_id"
            ref="l10n_br_account_payment_order.l10n_br_account_payment_mode_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='l10n-br-config']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('payment_method_code', 'not in', ('240','400', '500', 'itau_api', 'manual_test') )]}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
