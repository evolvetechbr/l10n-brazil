<odoo>
    <record
        id="l10n_br_account_payment_itau_api_res_config_settings_form"
        model="ir.ui.view"
    >
        <field
            name="name"
        >l10n_br_account_payment_itau_api.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane" id="itau_api_settings">
                        <label for="itau_api_url" />
                        <div class="text-muted">
                            Itaú API settings for boleto emission.
                        </div>
                        <div class="content-group mt16">
                            <field name="itau_api_url" />
                            <field name="itau_client_id" />
                            <field name="itau_client_secret" password="True" />
                            <field name="itau_certificate_id" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
